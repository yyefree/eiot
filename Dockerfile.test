# Test using the existing backend builder
FROM golang:1.24-alpine AS test-runner

WORKDIR /app

# Copy the entire backend source
COPY backend/ ./

# Install gcc for CGO
RUN apk add --no-cache gcc musl-dev

# Download dependencies
RUN go mod download

# Run go mod tidy to add test dependencies
RUN go mod tidy

# Run tests
RUN CGO_ENABLED=1 go test -v ./internal/logic/... 2>&1